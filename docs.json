{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "truemetrics Docs",
  "colors": {
    "primary": "#0097a7",
    "light": "#89effa",
    "dark": "#000214"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "groups": [
      {
        "group": "Getting started",
        "pages": [
          "introduction",
          "quickstart",
          "api_keys",
          "glossary"
        ]
      },
      {
        "group": "SDK integration",
        "pages": [
          "with_agent",
          "android_native",
          "ios",
          "flutter",
          "react_native",
          "expo",
          "metadata",
          "data_consumption_and_battery",
          "verify_integration"
        ]
      },
      {
        "group": "Data Export",
        "pages": [
          "Architecture_of_Export",
          "Introduction_to_data_export",
          "Update_and_Versioning"
        ]
      },
      {
        "group": "Last Meter Visualisation and Routing",
        "pages": [
          "lastmeter_routing_overview",
          {
            "group": "1 · In your own map",
            "pages": [
              "Introduction_to_lastmeter_visualisation",
              "Lastmeter_API_Reference",
              "Lastmeter_Examples"
            ]
          },
          {
            "group": "2 · truemetrics module",
            "pages": [
              "navigation_module",
              "navigation_module_with_agent"
            ]
          },
          {
            "group": "3 · Standalone navigation app",
            "pages": [
              "navigation_app",
              "navigation_app_with_agent"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "background": {
    "color": {
      "dark": "#000214"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:info@truemetrics.io"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/orgs/TRUE-Metrics-io/",
      "linkedin": "https://www.linkedin.com/company/truemetricsio"
    }
  },
  "redirects": [
    {
      "source": "/functions",
      "destination": "/android_native"
    },
    {
      "source": "/integrations",
      "destination": "/quickstart"
    },
    {
      "source": "/introduction_data",
      "destination": "/Introduction_to_data_export"
    },
    {
      "source": "/visualisations",
      "destination": "/Introduction_to_lastmeter_visualisation"
    },
    {
      "source": "/restAPI",
      "destination": "/introduction"
    },
    {
      "source": "/entrances",
      "destination": "/introduction"
    },
    {
      "source": "/development",
      "destination": "/introduction"
    },
    {
      "source": "/api-reference/:slug*",
      "destination": "/introduction"
    },
    {
      "source": "/essentials/:slug*",
      "destination": "/introduction"
    }
  ]
}
